  "components" : {
    "schemas" : {
      "AppResponse" : {
        "discriminator" : {
          "mapping" : {
            "browser" : "#/components/schemas/BrowserAppResponse",
            "calendar" : "#/components/schemas/CalendarAppResponse",
            "files" : "#/components/schemas/FilesAppResponse",
            "mail" : "#/components/schemas/MailAppResponse",
            "photos" : "#/components/schemas/PhotosAppResponse"
          },
          "propertyName" : "type"
        },
        "properties" : {
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "type" ]
      },
      "AttachmentRequest" : {
        "type" : "object",
        "properties" : {
          "appId" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "desktopId" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "itemId" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "appId", "desktopId", "itemId" ]
      },
      "AttemptResponse" : {
        "type" : "object",
        "properties" : {
          "answers" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "correctAnswers" : {
            "type" : "integer",
            "format" : "int32"
          },
          "number" : {
            "type" : "integer",
            "format" : "int32"
          },
          "submittedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "submittedBy" : {
            "type" : "string"
          },
          "totalQuestions" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "answers", "correctAnswers", "number", "submittedAt", "submittedBy", "totalQuestions" ]
      },
      "BrowserAppResponse" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/AppResponse"
        }, {
          "type" : "object",
          "properties" : {
            "id" : {
              "type" : "string"
            },
            "pages" : {
              "type" : "array",
              "items" : {
                "$ref" : "#/components/schemas/PageResponse"
              }
            },
            "title" : {
              "type" : "string"
            }
          },
          "required" : [ "id", "pages", "title" ]
        } ]
      },
      "CalendarAppResponse" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/AppResponse"
        }, {
