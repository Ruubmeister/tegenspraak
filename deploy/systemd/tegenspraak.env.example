# Copy to /etc/tegenspraak/tegenspraak.env (owner root, mode 600)

SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.internal:5432/tegenspraak
SPRING_DATASOURCE_USERNAME=tegenspraak
SPRING_DATASOURCE_PASSWORD=change-me

ANTHROPIC_API_KEY=sk-ant-change-me
# 8 to 72 characters, only used when the admin account is created on first startup
TEGENSPRAAK_ADMIN_PASSWORD=change-me

# Only reachable through nginx on the same machine
SERVER_ADDRESS=127.0.0.1
# Trust X-Forwarded-* from nginx so the session cookie is marked Secure behind HTTPS
SERVER_FORWARD_HEADERS_STRATEGY=native
